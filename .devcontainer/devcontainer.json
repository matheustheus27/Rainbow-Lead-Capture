{
  "name": "IrisCRM (Rainbow Lead Capture) DevContainer",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "backend",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "npm install --prefix backend && npm install --prefix frontend",
  "forwardPorts": [
    80,
    3000,
    5432
  ],
  "portsAttributes": {
    "80": {
      "label": "IrisCRM Web App (Nginx Reverse Proxy)",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "Backend API (Express / Node.js)",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "PostgreSQL Database",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "bradlc.vscode-tailwindcss",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "typescript.tsdk": "node_modules/typescript/lib",
        "sqltools.connections": [
          {
            "name": "IrisCRM PostgreSQL",
            "driver": "PostgreSQL",
            "server": "postgres-db",
            "port": 5432,
            "database": "iris_crm",
            "username": "dev_user",
            "password": "dev_password"
          }
        ]
      }
    }
  }
}