# Auto detect text files and perform global LF normalization
* text=auto eol=lf

# Explicit Source Code & Configuration Normalization
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
.env* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary Assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.svg text eol=lf
